# Copie para .env e ajuste. O Makefile e o docker compose leem este arquivo.

# Obrigatória: senha inicial do usuário "admin" da área da empresa.
ADMIN_PASSWORD=admin123

# Banco de dados. SQLite para desenvolvimento; PostgreSQL em produção.
DATABASE_URL=sqlite:///./barbearia.db
# DATABASE_URL=postgresql+psycopg://barbearia:barbearia@localhost:5432/barbearia

# Chave usada para assinar sessões e links mágicos. Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Se ficar vazia, uma chave aleatória é criada a cada inicialização (sessões caem ao reiniciar).
SECRET_KEY=

# Agenda
SLOT_MINUTES=15
INTERVALO_MINUTOS=0
TIMEZONE=America/Manaus

# Proteção da área pública
MAX_AGENDAMENTOS_ATIVOS_POR_CLIENTE=3
LIMITE_REQUISICOES_POR_MINUTO=60

# Notificações. Sem SMTP_HOST os e-mails vão para o log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=barbearia@exemplo.com
SMTP_TLS=1
LEMBRETE_HORAS=24
URL_PUBLICA=http://127.0.0.1:8000

# Servidor
HOST=127.0.0.1
PORTA_CLIENTE=8000
PORTA_ADMIN=8001
LOG_LEVEL=INFO
LOG_JSON=0
